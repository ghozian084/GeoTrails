# Firebase web config for GeoTrails Peta (Firebase console → Project settings → Your apps → Web).
# Put these in Vercel (Project → Settings → Environment Variables) or a local .env.local file.
# Without them, GeoTrails Peta works fully offline/locally and hides the class features.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional: Firestore database id when GeoTrails uses a named database (default: "(default)").
VITE_FIREBASE_DATABASE_ID=
