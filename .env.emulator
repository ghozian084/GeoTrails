# Local Firebase emulators only (`demo-` projects never reach a real Firebase project).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-geotrails.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-geotrails
VITE_FIREBASE_STORAGE_BUCKET=demo-geotrails.appspot.com
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_EMULATOR=127.0.0.1
VITE_FIREBASE_DATABASE_ID=geotrails
VITE_FIREBASE_DATABASE_URL=https://demo-geotrails-default-rtdb.firebaseio.com
