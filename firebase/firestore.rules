rules_version = '2';

// GeoTrails Peta: teachers publish maps to a class; anyone with the class code can read them.
// No student data is stored here (live multiplayer rooms are in the Realtime Database). Post photos are stored here too (one document per photo),
// so no Cloud Storage bucket, Blaze plan or CORS setup is needed.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Teachers sign in with Google; students only use anonymous sign-in (live rooms), never here.
    function teacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function ownsClass(code) {
      return teacher() && get(/databases/$(db)/documents/classes/$(code)).data.ownerUid == request.auth.uid;
    }

    // Site admins (the owner): a document per uid, created by hand in the console. Only readable by that admin.
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public maps: anyone can read approved ones. A teacher's submission (or any later change) waits
    // as "pending" until an admin approves it; an admin's own maps may be approved directly.
    match /public/{mapId} {
      function seeable(d) { return d.status == 'approved' || (teacher() && (d.ownerUid == request.auth.uid || isAdmin())); }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'json', 'photos', 'ownerUid', 'status', 'updatedAt', 'posts', 'cols', 'rows'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.json is string && d.json.size() < 900000
          && d.photos is list && d.photos.size() <= 12
          && d.ownerUid == request.auth.uid
          && (d.status == 'pending' || (d.status == 'approved' && isAdmin()))
          && d.updatedAt is number
          && d.posts is int && d.posts >= 1 && d.posts <= 12
          && d.cols is int && d.rows is int;
      }
      allow get, list: if seeable(resource.data);
      allow create: if teacher() && mapId.size() <= 60 && valid();
      allow update: if teacher() && (
        (resource.data.ownerUid == request.auth.uid && valid())
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'approved']));
      allow delete: if teacher() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /photos/{postUid} {
        function parent() { return get(/databases/$(db)/documents/public/$(mapId)).data; }
        allow read: if seeable(parent());
        allow create, update: if teacher() && parent().ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['data', 'type'])
          && request.resource.data.type == 'image/jpeg'
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
        allow delete: if teacher() && (parent().ownerUid == request.auth.uid || isAdmin());
      }
    }

    // Each teacher's own maps, synced between their devices. Only that teacher can read or write them.
    match /teachers/{uid}/maps/{mapId} {
      function me() { return teacher() && request.auth.uid == uid; }
      allow read, delete: if me();
      allow create, update: if me()
        && mapId.size() <= 60
        && request.resource.data.keys().hasOnly(['name', 'json', 'photos', 'updatedAt', 'deleted'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.json is string && request.resource.data.json.size() < 900000
        && request.resource.data.photos is map && request.resource.data.photos.size() <= 12
        && request.resource.data.updatedAt is number
        && request.resource.data.deleted is bool;

      match /photos/{postUid} {
        allow read, delete: if me();
        allow create, update: if me()
          && request.resource.data.keys().hasOnly(['data', 'type'])
          && request.resource.data.type == 'image/jpeg'
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
      }
    }

    // Trail sessions: a teacher picks a map and gets a code; groups that enter the code play that
    // map and send their results (group name, colour, points and per-post status, attempts,
    // hints, time and the numbers they answered). Only the session's teacher can read results.
    match /sessions/{code} {
      function ownsSession() { return teacher() && get(/databases/$(db)/documents/sessions/$(code)).data.ownerUid == request.auth.uid; }
      allow get: if true;
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if teacher()
        && code.matches('^[A-Z2-9]{6}$')
        && !exists(/databases/$(db)/documents/classes/$(code))
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'mapId', 'json', 'photos', 'open', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.mapId is string && request.resource.data.mapId.size() <= 60
        && request.resource.data.json is string && request.resource.data.json.size() < 900000
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 12
        && request.resource.data.open is bool
        && request.resource.data.createdAt is timestamp;
      // The teacher may rename the session or open/close it; the map stays as it was.
      allow update: if teacher() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'open'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.open is bool;
      allow delete: if teacher() && resource.data.ownerUid == request.auth.uid;

      match /photos/{postUid} {
        allow read: if true;
        allow create, update: if ownsSession()
          && request.resource.data.keys().hasOnly(['data', 'type'])
          && request.resource.data.type == 'image/jpeg'
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
        allow delete: if ownsSession();
      }

      // One document per group (its anonymous sign-in), written by that group while the session is open.
      match /results/{uid} {
        allow read, delete: if ownsSession();
        allow create, update: if signedIn() && request.auth.uid == uid
          && get(/databases/$(db)/documents/sessions/$(code)).data.open == true
          && request.resource.data.keys().hasOnly(['n', 'c', 's', 'posts', 'updatedAt'])
          && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 30
          && request.resource.data.c is string && request.resource.data.c.matches('^#[0-9A-Fa-f]{6}$')
          && request.resource.data.s is number && request.resource.data.s >= 0 && request.resource.data.s <= 1200
          && request.resource.data.posts is list && request.resource.data.posts.size() <= 12
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /classes/{code} {
      // Reading one class needs its code; only the owner can list their own classes.
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if teacher()
        && code.matches('^[A-Z2-9]{6}$')
        && !exists(/databases/$(db)/documents/sessions/$(code))
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /maps/{mapId} {
        allow read: if true;
        allow create, update: if ownsClass(code)
          && request.resource.data.keys().hasOnly(['name', 'json', 'photos', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.json is string && request.resource.data.json.size() < 900000
          && request.resource.data.photos is list && request.resource.data.photos.size() <= 12
          && request.resource.data.updatedAt is timestamp;
        allow delete: if ownsClass(code);

        // One JPEG per post, base64-encoded (documents are limited to 1 MiB).
        match /photos/{uid} {
          allow read: if true;
          allow create, update: if ownsClass(code)
            && request.resource.data.keys().hasOnly(['data', 'type'])
            && request.resource.data.type == 'image/jpeg'
            && request.resource.data.data is string && request.resource.data.data.size() < 950000;
          allow delete: if ownsClass(code);
        }
      }
    }
  }
}
