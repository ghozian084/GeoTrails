rules_version = '2';

// GeoTrails Peta: teachers publish maps to a class; anyone with the class code can read them.
// No student data is stored here (live multiplayer rooms are in the Realtime Database). Post photos are stored here too (one document per photo),
// so no Cloud Storage bucket, Blaze plan or CORS setup is needed.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Teachers sign in with Google; students only use anonymous sign-in (live rooms), never here.
    function teacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function ownsClass(code) {
      return teacher() && get(/databases/$(db)/documents/classes/$(code)).data.ownerUid == request.auth.uid;
    }

    match /classes/{code} {
      // Reading one class needs its code; only the owner can list their own classes.
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if teacher()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /maps/{mapId} {
        allow read: if true;
        allow create, update: if ownsClass(code)
          && request.resource.data.keys().hasOnly(['name', 'json', 'photos', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.json is string && request.resource.data.json.size() < 900000
          && request.resource.data.photos is list && request.resource.data.photos.size() <= 12
          && request.resource.data.updatedAt is timestamp;
        allow delete: if ownsClass(code);

        // One JPEG per post, base64-encoded (documents are limited to 1 MiB).
        match /photos/{uid} {
          allow read: if true;
          allow create, update: if ownsClass(code)
            && request.resource.data.keys().hasOnly(['data', 'type'])
            && request.resource.data.type == 'image/jpeg'
            && request.resource.data.data is string && request.resource.data.data.size() < 950000;
          allow delete: if ownsClass(code);
        }
      }
    }
  }
}
