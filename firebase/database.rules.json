{
  "rules": {
    "live": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        "owner": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "rooms": {
          ".write": "auth != null && !newData.exists() && root.child('live').child($code).child('owner').val() === auth.uid",
          "$mapId": {
            ".read": "auth != null",
            ".write": "auth != null && !newData.exists() && root.child('live').child($code).child('owner').val() === auth.uid",
            ".validate": "$mapId.matches(/^[A-Za-z0-9_-]{1,40}$/)",
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.child('t').val() < now - 86400000))",
              ".validate": "newData.hasChildren(['n', 'c', 'x', 'y', 'd', 's', 'p', 'on', 't'])",
              "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
              "c": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
              "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40" },
              "d": { ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1200" },
              "p": { ".validate": "newData.isString() && newData.val().matches(/^[gor-]{1,12}$/)" },
              "on": { ".validate": "newData.isBoolean()" },
              "t": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
