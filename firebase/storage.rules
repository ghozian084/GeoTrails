rules_version = '2';

// Post photos of published maps live under the teacher's own uid. Anyone can read them
// (students find the path from the class document's ownerUid); only that teacher can write.
// This avoids cross-service rules (which would need extra IAM setup).
service firebase.storage {
  match /b/{bucket}/o {
    match /owners/{uid}/classes/{code}/maps/{mapId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 3 * 1024 * 1024 && request.resource.contentType == 'image/jpeg'));
    }
  }
}
