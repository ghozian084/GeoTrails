{
  "name": "geotrails",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-geotrails --only firestore \"vitest run -c vitest.rules.config.ts\"",
    "e2e:cloud": "firebase emulators:exec --project demo-geotrails --only auth,firestore \"playwright test -c playwright.cloud.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^13.1.0",
    "three": "^0.186.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
